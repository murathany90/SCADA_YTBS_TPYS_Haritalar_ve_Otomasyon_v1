{
  "manifest_version": 3,
  "name": "SCADA/YTBS/TPYS/ Haritalar ve Otomasyon",
  "version": "1.0.0",
  "description": "TPYS reaktif CSV eşleştirme, zenginleştirilmiş KML haritası, bara set görselleştirme ve tam otomatik CSV indirme.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SCADA/YTBS/TPYS/ Haritalar ve Otomasyon",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
